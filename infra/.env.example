# Synthetic local values. Copy to infra/.env (gitignored) before
# `docker compose -f infra/compose.yaml up -d db`.
# These match the dev and test defaults in energyiq.platform.settings, so a
# local run needs no ENERGYIQ_* variables. Never reuse them outside your machine.

# Superuser for the container only; the app never uses it.
POSTGRES_PASSWORD=energyiq-local-postgres

# Owns the databases and runs Alembic, the maintenance command, and test setup.
ENERGYIQ_MIGRATOR_PASSWORD=energyiq-local-migrator

# The app role: LOGIN only; table privileges come from each Alembic revision.
ENERGYIQ_APP_PASSWORD=energyiq-local-app
