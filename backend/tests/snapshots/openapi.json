{
  "components": {
    "schemas": {
      "ConflictEntryOut": {
        "properties": {
          "input_index": {
            "title": "Input Index",
            "type": "integer"
          },
          "reading_id": {
            "format": "uuid",
            "title": "Reading Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ReadingStatus"
          }
        },
        "required": [
          "input_index",
          "reading_id",
          "status"
        ],
        "title": "ConflictEntryOut",
        "type": "object"
      },
      "ConflictOut": {
        "description": "Readings at the same UTC instant (P1-02 conflict group).",
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/ConflictEntryOut"
            },
            "title": "Entries",
            "type": "array"
          },
          "recorded_at": {
            "title": "Recorded At",
            "type": "string"
          }
        },
        "required": [
          "recorded_at",
          "entries"
        ],
        "title": "ConflictOut",
        "type": "object"
      },
      "ConsumptionProblem": {
        "description": "Problem body for the summary route, with its extension members.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "conflicts": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ConflictOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conflicts"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "duplicates": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DuplicateIdOut"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duplicates"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationErrorItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "errors_truncated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors Truncated"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "code",
          "request_id"
        ],
        "title": "ConsumptionProblem",
        "type": "object"
      },
      "ConsumptionSummaryRequest": {
        "additionalProperties": false,
        "description": "Readings and events for one meter, summarized over one window.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventIn"
            },
            "maxItems": 500,
            "title": "Events",
            "type": "array"
          },
          "meter_id": {
            "format": "uuid",
            "title": "Meter Id",
            "type": "string"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/ReadingIn"
            },
            "maxItems": 5000,
            "title": "Readings",
            "type": "array"
          },
          "window": {
            "$ref": "#/components/schemas/WindowIn"
          }
        },
        "required": [
          "meter_id",
          "window",
          "readings"
        ],
        "title": "ConsumptionSummaryRequest",
        "type": "object"
      },
      "ConsumptionSummaryResponse": {
        "description": "Exact window summary plus every interval; Decimals are strings.",
        "properties": {
          "average_kwh_per_day": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Kwh Per Day"
          },
          "coverage_ratio": {
            "title": "Coverage Ratio",
            "type": "string"
          },
          "covered": {
            "title": "Covered",
            "type": "string"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/GapOut"
            },
            "title": "Gaps",
            "type": "array"
          },
          "intervals": {
            "items": {
              "$ref": "#/components/schemas/IntervalOut"
            },
            "title": "Intervals",
            "type": "array"
          },
          "measured_kwh": {
            "title": "Measured Kwh",
            "type": "string"
          },
          "meter_id": {
            "format": "uuid",
            "title": "Meter Id",
            "type": "string"
          },
          "uncovered": {
            "title": "Uncovered",
            "type": "string"
          },
          "window": {
            "$ref": "#/components/schemas/WindowOut"
          }
        },
        "required": [
          "meter_id",
          "window",
          "measured_kwh",
          "covered",
          "uncovered",
          "coverage_ratio",
          "average_kwh_per_day",
          "gaps",
          "intervals"
        ],
        "title": "ConsumptionSummaryResponse",
        "type": "object"
      },
      "DuplicateIdOut": {
        "description": "An id repeated inside one collection, with every input index.",
        "properties": {
          "collection": {
            "enum": [
              "readings",
              "events"
            ],
            "title": "Collection",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "input_indexes": {
            "items": {
              "type": "integer"
            },
            "title": "Input Indexes",
            "type": "array"
          }
        },
        "required": [
          "collection",
          "id",
          "input_indexes"
        ],
        "title": "DuplicateIdOut",
        "type": "object"
      },
      "EventIn": {
        "additionalProperties": false,
        "description": "One meter event; approval fields come together or not at all.",
        "properties": {
          "approved_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved At"
          },
          "approved_by": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved By"
          },
          "effective_at": {
            "format": "date-time",
            "title": "Effective At",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/MeterEventType"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "event_type",
          "effective_at"
        ],
        "title": "EventIn",
        "type": "object"
      },
      "GapOut": {
        "description": "One in window span without a measured value, with its cause.",
        "properties": {
          "current_reading_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Reading Id"
          },
          "duration": {
            "title": "Duration",
            "type": "string"
          },
          "end": {
            "title": "End",
            "type": "string"
          },
          "event_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Event Ids",
            "type": "array"
          },
          "interval_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntervalReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_reading_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Reading Id"
          },
          "reason": {
            "$ref": "#/components/schemas/GapReason"
          },
          "start": {
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "duration",
          "reason",
          "interval_reason",
          "previous_reading_id",
          "current_reading_id",
          "event_ids"
        ],
        "title": "GapOut",
        "type": "object"
      },
      "GapReason": {
        "enum": [
          "before_first_reading",
          "after_last_reading",
          "no_intervals",
          "partial_interval",
          "invalid_interval"
        ],
        "title": "GapReason",
        "type": "string"
      },
      "HealthResponse": {
        "description": "Body of ``GET /health``.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IntervalOut": {
        "description": "One interval of the chain; ``measured_in_window`` marks summed ones.",
        "properties": {
          "consumption_kwh": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consumption Kwh"
          },
          "current_reading_id": {
            "format": "uuid",
            "title": "Current Reading Id",
            "type": "string"
          },
          "duration": {
            "title": "Duration",
            "type": "string"
          },
          "end": {
            "title": "End",
            "type": "string"
          },
          "event_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Event Ids",
            "type": "array"
          },
          "kwh_per_day": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kwh Per Day"
          },
          "measured_in_window": {
            "title": "Measured In Window",
            "type": "boolean"
          },
          "previous_reading_id": {
            "format": "uuid",
            "title": "Previous Reading Id",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IntervalReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "start": {
            "title": "Start",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/IntervalStatus"
          }
        },
        "required": [
          "previous_reading_id",
          "current_reading_id",
          "start",
          "end",
          "duration",
          "status",
          "reason",
          "event_ids",
          "consumption_kwh",
          "kwh_per_day",
          "measured_in_window"
        ],
        "title": "IntervalOut",
        "type": "object"
      },
      "IntervalReason": {
        "enum": [
          "flagged_reading",
          "unapproved_event",
          "meter_boundary",
          "unsupported_event",
          "unexplained_decrease"
        ],
        "title": "IntervalReason",
        "type": "string"
      },
      "IntervalStatus": {
        "enum": [
          "valid",
          "invalid"
        ],
        "title": "IntervalStatus",
        "type": "string"
      },
      "MeterEventType": {
        "enum": [
          "installed",
          "reset",
          "replaced",
          "rollover",
          "calibration"
        ],
        "title": "MeterEventType",
        "type": "string"
      },
      "ReadingIn": {
        "additionalProperties": false,
        "description": "One cumulative reading; ``created_at`` is stamped by the server.",
        "properties": {
          "cumulative_kwh": {
            "pattern": "^[0-9]{1,12}(\\.[0-9]{1,6})?$",
            "title": "Cumulative Kwh",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "recorded_at": {
            "format": "date-time",
            "title": "Recorded At",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/ReadingSource",
            "default": "manual"
          },
          "status": {
            "$ref": "#/components/schemas/ReadingStatus",
            "default": "valid"
          }
        },
        "required": [
          "id",
          "recorded_at",
          "cumulative_kwh"
        ],
        "title": "ReadingIn",
        "type": "object"
      },
      "ReadingSource": {
        "enum": [
          "manual",
          "import"
        ],
        "title": "ReadingSource",
        "type": "string"
      },
      "ReadingStatus": {
        "enum": [
          "valid",
          "flagged",
          "voided"
        ],
        "title": "ReadingStatus",
        "type": "string"
      },
      "ValidationErrorItem": {
        "description": "One located validation failure; never carries the submitted value.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "code",
          "message"
        ],
        "title": "ValidationErrorItem",
        "type": "object"
      },
      "WindowIn": {
        "additionalProperties": false,
        "description": "Half open ``[start, end)`` window; any explicit offset, stored as UTC.",
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "WindowIn",
        "type": "object"
      },
      "WindowOut": {
        "properties": {
          "end": {
            "title": "End",
            "type": "string"
          },
          "start": {
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "WindowOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "EnergyIQ RD",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/consumption/summary": {
      "post": {
        "description": "Summarize posted readings and events over a window. Stores nothing.\n\nStages run in a fixed order and the first failure answers: schema,\nduplicate ids, mapping, timestamp conflicts, then computation (AC-5a).",
        "operationId": "consumption_summary_api_v1_consumption_summary_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsumptionSummaryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionSummaryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionProblem"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionProblem"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionProblem"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionProblem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Consumption Summary",
        "tags": [
          "consumption"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report that the process is serving requests, and its version.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
